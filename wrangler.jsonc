// Cloudflare (Workers com assets estáticos). Sem este arquivo o wrangler tenta
// se autoconfigurar e exige Vite >= 6 — aqui ele só publica a pasta dist/.
// Os cabeçalhos (cache, frame-ancestors da ATHG) vêm de public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profund-io",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist"
  }
}
